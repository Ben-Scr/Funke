#include <winver.h>
#include "BuildMetadata.generated.hpp"
#include "BuildIdentity.generated.hpp"

#ifndef IDX_FILE_TYPE
#define IDX_FILE_TYPE VFT_APP
#endif

1 VERSIONINFO
 FILEVERSION IDX_VERSION_RESOURCE
 PRODUCTVERSION IDX_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if defined(_DEBUG)
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRIVATEBUILD | VS_FF_SPECIALBUILD
#elif IDX_BUILD_DIRTY
 FILEFLAGS VS_FF_PRIVATEBUILD | VS_FF_SPECIALBUILD
#else
 FILEFLAGS VS_FF_SPECIALBUILD
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE IDX_FILE_TYPE
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Index Contributors\0"
            VALUE "FileDescription", IDX_FILE_DESCRIPTION "\0"
            VALUE "FileVersion", IDX_VERSION "\0"
            VALUE "InternalName", IDX_INTERNAL_NAME "\0"
            VALUE "OriginalFilename", IDX_ORIGINAL_FILENAME "\0"
            VALUE "ProductName", "Index\0"
            VALUE "ProductVersion", IDX_VERSION "\0"
            VALUE "PrivateBuild", IDX_BUILD_ID "\0"
            VALUE "SpecialBuild", IDX_BUILD_ID "\0"
            VALUE "BuildId", IDX_BUILD_ID "\0"
            VALUE "Commit", IDX_BUILD_COMMIT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
