+        static_assert(storage_policy == deletion_policy::swap_and_pop, "Bulk removal requires swap-and-pop storage");
+        static_assert(std::is_nothrow_move_assignable_v<value_type> && std::is_nothrow_destructible_v<value_type>, "Bulk removal must not throw");
+
+        bulk_remove_plan plan;
+        plan.owner = this;
+        plan.previous = base_type::size();
+        plan.entities.assign(first, last);
+        ENTT_ASSERT(plan.entities.size() <= plan.previous, "Invalid bulk removal range");
