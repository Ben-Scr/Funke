+        const auto count = static_cast<size_type>(std::distance(first, last));
+        if(count == 0u) {
+            return;
+        }
+
+        const auto offset = base_type::size();
+        if(count > std::numeric_limits<size_type>::max() - offset) {
+            ENTT_THROW std::length_error{"Bulk storage size overflow"};
+            return;
+        }
+        reserve(offset + count);
