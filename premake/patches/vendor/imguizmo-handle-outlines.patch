+   // Index patch: dark halo behind gizmo handles so they stay visible when the
+   // entity under them shares the handle's color (e.g. a blue UI panel hiding the
+   // blue/white handles). Each helper draws a slightly larger/thicker black shape
+   // that the colored primitive is then painted over — the same outline trick the
+   // bound anchors already use. This whole submodule is kept dirty, never committed.
+   static const ImU32 k_GizmoOutlineColor = IM_COL32(0, 0, 0, 200);
+   static const float k_GizmoOutlineExtra = 2.0f; // extra px added to thickness / diameter
+
+   static void GizmoOutlineLine(ImDrawList* dl, const ImVec2& a, const ImVec2& b, float thickness)
+   {
+      dl->AddLine(a, b, k_GizmoOutlineColor, thickness + k_GizmoOutlineExtra);
+   }
+   static void GizmoOutlineCircleFilled(ImDrawList* dl, const ImVec2& c, float radius, int segments)
+   {
+      dl->AddCircleFilled(c, radius + k_GizmoOutlineExtra * 0.5f, k_GizmoOutlineColor, segments);
+   }
+   static void GizmoOutlineCircle(ImDrawList* dl, const ImVec2& c, float radius, int segments, float thickness)
+   {
+      dl->AddCircle(c, radius, k_GizmoOutlineColor, segments, thickness + k_GizmoOutlineExtra);
+   }
+   static void GizmoOutlinePolyline(ImDrawList* dl, const ImVec2* pts, int count, ImDrawFlags flags, float thickness)
+   {
+      dl->AddPolyline(pts, count, k_GizmoOutlineColor, flags, thickness + k_GizmoOutlineExtra);
+   }
