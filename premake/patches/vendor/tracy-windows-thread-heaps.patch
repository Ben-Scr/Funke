@@ -13,7 +13,15 @@
 
 #include "tracy_rpmalloc.hpp"
 
+// Funke keeps Tracy loaded for the process lifetime. Enable rpmalloc's Windows
+// FLS destructor so terminated application threads orphan their heaps for reuse.
+// The upstream dynamic-link setting disables this callback without providing a
+// replacement in Tracy.dll; even naming a short-lived thread then retains MiBs.
+#if defined(_WIN32)
+#define BUILD_DYNAMIC_LINK 0
+#else
 #define BUILD_DYNAMIC_LINK 1
+#endif
 
