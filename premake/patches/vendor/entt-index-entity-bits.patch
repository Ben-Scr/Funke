--- a/src/entt/entity/entity.hpp
+++ b/src/entt/entity/entity.hpp
@@ -34,6 +34,30 @@ struct entt_traits<Type>
     using value_type = Type;
 };
 
+// Index-engine patch: the entity/version bit split is configurable at
+// build time via the `entityBits` field in index-project.json, which
+// premake translates into a -DINDEX_ENTITY_BITS=N define. The EnTT
+// stock split (20 entity / 12 version) caps a scene at 1,048,575 live
+// entities — that's the default the engine ships with. Selecting 22,
+// 24, or 28 raises that to 4M / 16M / 268M respectively at the cost
+// of fewer version bits (EnTT uses the version to detect stale handles
+// to recycled slots; fewer bits = aliasing happens sooner). See
+// premake5.lua's GetIndexEntityBits() and the editor's Project Settings
+// panel for the user-facing surfaces.
+//
+// On top of the build-time -D, the editor's "Rebuild Engine" flow can
+// change the bit split without forcing a premake regen by rewriting a
+// generated header that #undef/#defines INDEX_ENTITY_BITS to the new
+// value. The header lives at:
+//   Index-Engine/src/Generated/IndexEntityBitsConfig.h
+// and that folder is on every C++ project's include path (the four main
+// projects + native package layers; see WriteIndexEntityBitsConfigHeader
+// in premake5.lua). __has_include guards the inclusion so a missing or
+// stale-include-path build still falls back to the -D value.
+#if __has_include("IndexEntityBitsConfig.h")
+#  include "IndexEntityBitsConfig.h"
+#endif
+
 template<>
 struct entt_traits<std::uint32_t> {
     using value_type = std::uint32_t;
@@ -41,8 +65,29 @@ struct entt_traits<std::uint32_t> {
     using entity_type = std::uint32_t;
     using version_type = std::uint16_t;
 
+#if defined(INDEX_ENTITY_BITS)
+  #if   INDEX_ENTITY_BITS == 16
+    static constexpr entity_type entity_mask  = 0xFFFF;
+    static constexpr entity_type version_mask = 0xFFFF;
+  #elif INDEX_ENTITY_BITS == 20
+    static constexpr entity_type entity_mask  = 0xFFFFF;
+    static constexpr entity_type version_mask = 0xFFF;
+  #elif INDEX_ENTITY_BITS == 22
+    static constexpr entity_type entity_mask  = 0x3FFFFF;
+    static constexpr entity_type version_mask = 0x3FF;
+  #elif INDEX_ENTITY_BITS == 24
+    static constexpr entity_type entity_mask  = 0xFFFFFF;
+    static constexpr entity_type version_mask = 0xFF;
+  #elif INDEX_ENTITY_BITS == 28
+    static constexpr entity_type entity_mask  = 0xFFFFFFF;
+    static constexpr entity_type version_mask = 0xF;
+  #else
+    #error "INDEX_ENTITY_BITS must be one of: 16, 20, 22, 24, 28"
+  #endif
+#else
     static constexpr entity_type entity_mask = 0xFFFFF;
     static constexpr entity_type version_mask = 0xFFF;
+#endif
 };
 
 template<>
