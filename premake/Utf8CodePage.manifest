<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes the process ANSI code page UTF-8 (Windows 10 1903+). The engine stores paths and text as UTF-8,
     but MSVC std::filesystem and the narrow Win32 APIs decode std::string with the ANSI code page: without
     this, paths with characters outside the user's locale throw (path::string()) or get mangled. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
