<Project>
  <PropertyGroup>
    <FunkePythonExe Condition="'$(FunkePythonExe)' == ''">python</FunkePythonExe>
    <FunkeBuildMetadataScript>$(MSBuildThisFileDirectory)scripts\generate_build_metadata.py</FunkeBuildMetadataScript>
    <FunkeBuildMetadataScope Condition="'$(FunkeBuildMetadataScope)' == '' and '$(Configuration)' != 'Dist' and '$(ContinuousIntegrationBuild)' != 'true'">engine</FunkeBuildMetadataScope>
    <FunkeBuildMetadataScope Condition="'$(FunkeBuildMetadataScope)' == ''">repository</FunkeBuildMetadataScope>
  </PropertyGroup>
  <!--
    Local iteration fingerprints engine inputs so editor, documentation and asset
    edits do not relink the DLL. CI and BuildWindows.ps1 retain repository-wide
    identity. BuildGenerateSources keeps this out of reference-information queries.
  -->
  <Target Name="GenerateFunkeBuildMetadata"
          BeforeTargets="BuildGenerateSources"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Funke-Engine' and Exists('$(FunkeBuildMetadataScript)')">
    <Exec Command="&quot;$(FunkePythonExe)&quot; &quot;$(FunkeBuildMetadataScript)&quot; --identity-scope $(FunkeBuildMetadataScope)" />
  </Target>
</Project>
