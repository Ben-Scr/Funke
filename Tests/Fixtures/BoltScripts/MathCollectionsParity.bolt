import Funke
import Funke.AI
import Funke.Collections
import Funke.Collections.Native
import Funke.Coroutines
import System.Threading

public class MathCollectionsProbe : EntityScript {
private:
    static int signals;
public:
    public int Result = -1;
    public override void OnStart() {
        Result = MathCollectionsParity.Verify();
        signals = 0;
        var next = Funke.Coroutines.WaitForFrames(2).GetAwaiter();
        next.OnCompleted(() => { next.GetResult(); signals += 1; });
        var fixedStep = Funke.Coroutines.WaitForFixedUpdate().GetAwaiter();
        fixedStep.OnCompleted(() => { fixedStep.GetResult(); signals += 2; });
        CancellationTokenSource stop;
        var canceled = Funke.Coroutines.WaitForSeconds(10,stop.Token).GetAwaiter();
        canceled.OnCompleted(() => {
            try { canceled.GetResult(); }
            catch (System.OperationCanceledException& error) { signals += 4; }
        });
        stop.Cancel();
    }
    public override void OnUpdate() { Transform2D.Position = Vector2((float)signals,0); }
}

