{
  "project": "Examples/BoltScriptBench",
  "platform": "Windows x64",
  "cpu": "AMD Ryzen 9 7900X, 12 cores, 24 logical processors",
  "goal": {
    "entitiesPerBatch": 10000,
    "millisecondsPerOperation": 0.1,
    "nanosecondsPerEntity": 10
  },
  "protocol": "Each backend runs in fresh processes. One warm-up round per language precedes seven timed samples per operation. The first language alternates each round. Every process reports its median in 100 ns ticks. The ms tables report the median of those process medians. Timer readings cover the scripting API calls, including entering native code.",
  "pointIds": {
    "storage": "Scene registry entities with a native generation and one 12-byte component (batch stamp, X and Y). No default Transform2D or persistent UUID.",
    "buffers": "Each script allocates its ID and XY buffers before timing. Create includes any native pool growth it triggers. Warm-up leaves vacant slots and reusable native capacity.",
    "Create": "Make 10,000 live scene entities at the origin and write every ID into the script buffer.",
    "Move": "Pass the stored IDs, validate their lifetimes and add (1, 2) to each XY pair in native scene storage.",
    "Read": "Copy all 20,000 coordinates back to the script in ID order and sum the returned numbers in Bolt or C# inside the timer.",
    "Destroy": "Invalidate every ID and remove the corresponding component and live entity. The workload releases the batch in creation order.",
    "validation": "Check creation and live counts, moved/read counts, position checksum of 30,000, destruction count and zero remaining live IDs."
  },
  "sceneObjects": "Original Entity + Transform workload, including Create, reading and writing Transform2D.Position, summing the position values and individual Destroy calls.",
  "reproduction": {
    "editor": [
      "funke test Examples/BoltScriptBench/Tests/PointIds.test.json",
      "funke test Examples/BoltScriptBench/Tests/Lifecycle.test.json"
    ],
    "player": "Export the Windows Release profile. Launch the executable, select 10,000 and Run in each mode. Repeat in a fresh process for each trial. The player measurements cleared BOLT_* and LLVM_* variables and limited PATH to Windows and System32. The runtime log confirmed loading the Windows AOT module."
  },
