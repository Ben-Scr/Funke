import Funke

public class EntityCompute : EntityScript
{
    private ulong state = 0ul;

    public override void OnUpdate()
    {
        ulong next = state;
        for (int i = 0; i < 256; i++)
            next = (next * 25173ul + 13849ul) % 65521ul;
        state = next;
        Vector2 position = Transform2D.Position;
        position.X += (float)(1ul + state % 8ul);
        Transform2D.Position = position;
    }
}

