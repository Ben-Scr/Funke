import Funke

public class ResetPlayProbe : EntityScript {
private:
    static int counter = 600;
    [ResetOnPlay] private static void ResetCounter() { counter = 0; }

    class Nested {
    private:
        static int counter = 700;
        [ResetOnPlay] private static void ResetCounter() { counter = 0; }
    public:
        static int Next() { return ++counter; }
    }
public:
    public override void OnUpdate() {
        counter++;
        Transform2D.Position = Vector2((float)counter,(float)Nested.Next());
    }
}
