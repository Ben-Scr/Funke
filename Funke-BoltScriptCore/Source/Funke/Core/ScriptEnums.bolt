}

public enum MediaCommand {
    None = 0,
    Play = 1,
    Pause = 2,
    Next = 3,
    Previous = 4,
    Seek = 5
}

public enum CursorMode {
    Default = 0,
    Locked = 1
}

public enum DebugMetric : ulong {
    CompletedFrame = 1ul,
    ProcessMemory = 2ul,
    VirtualMemory = 4ul,
    CurrentThreadStack = 8ul,
    TrackedAllocations = 16ul,
    ScratchArenas = 32ul,
    RenderThreadTiming = 64ul,
    Lights2D = 128ul
}

