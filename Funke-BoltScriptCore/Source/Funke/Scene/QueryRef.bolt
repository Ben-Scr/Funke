namespace Funke;

public class QueryRefBuilder1<W1Type> {
public:
    FkQueryRefSpec FkSpec;
    QueryRefBuilder1<W1Type> With<T>() { QueryRefBuilder1<W1Type> copy = this; copy.FkSpec.Required += FkQueryRefSpec.Key<T>(); return copy; }
    QueryRefBuilder1<W1Type> Without<T>() { QueryRefBuilder1<W1Type> copy = this; copy.FkSpec.Excluded += FkQueryRefSpec.Key<T>(); return copy; }
    QueryRefBuilder1<W1Type> EnabledOnly() { QueryRefBuilder1<W1Type> copy = this; copy.FkSpec.EnableFilter = 1; return copy; }
    QueryRefBuilder1<W1Type> DisabledOnly() { QueryRefBuilder1<W1Type> copy = this; copy.FkSpec.EnableFilter = 2; return copy; }
    QueryRefBuilder1<W1Type> IncludeDisabled() { QueryRefBuilder1<W1Type> copy = this; copy.FkSpec.EnableFilter = 0; return copy; }
    QueryRefEntityBuilder1<W1Type> WithEntity() { QueryRefEntityBuilder1<W1Type> copy; copy.FkSpec = FkSpec; return copy; }
    QueryRefBuilder1_RO1<W1Type, RType> Readonly<RType>() { QueryRefBuilder1_RO1<W1Type, RType> copy; copy.FkSpec = FkSpec; copy.FkSpec.Reads = FkQueryRefSpec.Key<RType>(); return copy; }
    public class Enumerator {
    public:
        FkQueryRefCursor FkCursor;
        bool MoveNext() { return FkCursor.MoveNext(); }
        void Dispose() { FkCursor.Dispose(); }
        W1Type& Current { get { return *((W1Type*)FkCursor.Data.Get().Cell(FkCursor.Index, 0)); } }
    }
    Enumerator GetEnumerator() {
        Enumerator result;
        result.FkCursor.Open(FkSpec, 1, false);
        return result;
    }
}

public class QueryRefEntityBuilder1<W1Type> {
public:
    FkQueryRefSpec FkSpec;
    public class Row {
    public:
        FkQueryRefCursor FkCursor;
        EntityRef Entity => FkCursor.Data.Get().EntityAt(FkCursor.Index);
        W1Type& W1 { get { return *((W1Type*)FkCursor.Data.Get().Cell(FkCursor.Index, 0)); } }
        W1Type& W { get { return *((W1Type*)FkCursor.Data.Get().Cell(FkCursor.Index, 0)); } }
        void Deconstruct(EntityRef& entity, Funke.Components.Ref<W1Type>& w1) {
            entity = Entity;
            w1 = Funke.Components.Ref<W1Type>.FkBorrow((W1Type*)FkCursor.Data.Get().Cell(FkCursor.Index, 0));
        }
    }
    public class Enumerator {
    public:
        FkQueryRefCursor FkCursor;
        bool MoveNext() { return FkCursor.MoveNext(); }
        void Dispose() { FkCursor.Dispose(); }
        Row Current { get { Row row; row.FkCursor = FkCursor; return row; } }
    }
    Enumerator GetEnumerator() {
        Enumerator result;
        result.FkCursor.Open(FkSpec, 1, true);
        return result;
    }
}

