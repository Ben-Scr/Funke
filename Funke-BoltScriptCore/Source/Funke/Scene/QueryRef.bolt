public static class SceneQueryRows {
public:
    static void Deconstruct<T1, T2>(this QueryRow<T1, T2> row, Entity& entity, T1& c1, T2& c2) { entity = row.Entity; c1 = row.Get<T1>(); c2 = row.Get<T2>(); }
    static void Deconstruct<T1, T2>(this QueryRow<T1, T2> row, T1& c1, T2& c2) { c1 = row.Get<T1>(); c2 = row.Get<T2>(); }
    static void Deconstruct<T1, T2, T3>(this QueryRow<T1, T2, T3> row, Entity& entity, T1& c1, T2& c2, T3& c3) { entity = row.Entity; c1 = row.Get<T1>(); c2 = row.Get<T2>(); c3 = row.Get<T3>(); }
    static void Deconstruct<T1, T2, T3>(this QueryRow<T1, T2, T3> row, T1& c1, T2& c2, T3& c3) { c1 = row.Get<T1>(); c2 = row.Get<T2>(); c3 = row.Get<T3>(); }
