import Funke
namespace Funke.UI;

public class Scrollbar : Component {
public:
    protected override ulong FkType() { return 36ul; }
    float Value { get { return Reinterpret<float>((uint)FkScrollbar_GetValue(ID, 0ul)); } set { FkScrollbar_SetValue(ID, (ulong)Reinterpret<uint>(value)); } }
    float Size { get { return Reinterpret<float>((uint)FkScrollbar_GetSize(ID, 0ul)); } set { FkScrollbar_SetSize(ID, (ulong)Reinterpret<uint>(value)); } }
    int NumberOfSteps { get { return Reinterpret<int>((uint)(FkScrollbar_GetNumberOfSteps(ID, 0ul) & 4294967295ul)); } set { FkScrollbar_SetNumberOfSteps(ID, (ulong)Reinterpret<uint>(value)); } }
    ScrollbarDirection Direction { get { return (ScrollbarDirection)FkScrollbar_GetDirection(ID, 0ul); } set { FkScrollbar_SetDirection(ID, (ulong)value); } }
    bool IsReadOnly { get { return (FkScrollbar_GetIsReadOnly(ID, 0ul) != 0ul); } set { FkScrollbar_SetIsReadOnly(ID, (value ? 1ul : 0ul)); } }
    UITransitionMode TransitionMode { get { return (UITransitionMode)FkScrollbar_GetTransitionMode(ID, 0ul); } set { FkScrollbar_SetTransitionMode(ID, (ulong)value); } }
    Vector4 NormalColor { get { return FunkeApiTypes.DecodeVector4(FkScrollbar_GetNormalColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkScrollbar_SetNormalColor(ID, value.LowBits()); } }
    Vector4 HoveredColor { get { return FunkeApiTypes.DecodeVector4(FkScrollbar_GetHoveredColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkScrollbar_SetHoveredColor(ID, value.LowBits()); } }
    Vector4 PressedColor { get { return FunkeApiTypes.DecodeVector4(FkScrollbar_GetPressedColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkScrollbar_SetPressedColor(ID, value.LowBits()); } }
    Vector4 DisabledColor { get { return FunkeApiTypes.DecodeVector4(FkScrollbar_GetDisabledColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkScrollbar_SetDisabledColor(ID, value.LowBits()); } }
    Vector4 FocusedColor { get { return FunkeApiTypes.DecodeVector4(FkScrollbar_GetFocusedColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkScrollbar_SetFocusedColor(ID, value.LowBits()); } }
    bool ValueChangedThisFrame => (FkScrollbar_GetValueChangedThisFrame(ID, 0ul) != 0ul);
    Funke.Entity? HandleEntity { get { return Funke.Entity.FromId(FkScrollbar_GetHandleEntity(ID, 0ul)); } set { ulong id = 0ul; if (value != null) id = value.Value.ID; FkScrollbar_SetHandleEntity(ID, id); } }
    Funke.Texture? NormalSprite { get { return Funke.Texture.FromAssetUUID(FkScrollbar_GetNormalSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkScrollbar_SetNormalSprite(ID, guid); } }
    Funke.Texture? HoveredSprite { get { return Funke.Texture.FromAssetUUID(FkScrollbar_GetHoveredSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkScrollbar_SetHoveredSprite(ID, guid); } }
    Funke.Texture? PressedSprite { get { return Funke.Texture.FromAssetUUID(FkScrollbar_GetPressedSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkScrollbar_SetPressedSprite(ID, guid); } }
    Funke.Texture? DisabledSprite { get { return Funke.Texture.FromAssetUUID(FkScrollbar_GetDisabledSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkScrollbar_SetDisabledSprite(ID, guid); } }
    Funke.Texture? FocusedSprite { get { return Funke.Texture.FromAssetUUID(FkScrollbar_GetFocusedSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkScrollbar_SetFocusedSprite(ID, guid); } }
    void SetValue(float value, bool notifyEvent = true) {
        float previous = Value;
        Value = value;
        FkScrollbar_MarkValueObserved(ID, 0ul);
        float applied = Value;
        if (notifyEvent && applied != previous) Events.FkChanged(applied);
    }
    ScrollbarEvents& Events { get { return FkUiStore<Scrollbar, ScrollbarEvents>.For(ID).Get(); } }
    WidgetEvent<float> ValueChanged {
        get {
            Shared<ScrollbarEvents> state = FkUiStore<Scrollbar, ScrollbarEvents>.For(ID);
            WidgetEvent<float> signal;
            signal.FkAdd = (Action<float> h) => { state.Get().ValueChanged += h; };
            signal.FkRemove = (Action<float> h) => { state.Get().ValueChanged -= h; };
            return signal;
        }
        set {}
    }
}
