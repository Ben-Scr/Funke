public class ScrollRectEvents {
public:
    event Action<Vector2> ValueChanged;
    void FkChanged(Vector2 value) { ValueChanged.Invoke(value); }
    void FkPoll(ScrollRect widget) {
        if (FkScrollRect_GetValueChangedThisFrame(widget.ID, 0ul) != 0ul) ValueChanged.Invoke(widget.NormalizedPosition);
    }
}

public static class FkUiDispatch {
public:
    static void Tick() {
        FkUiStore<Interactable, InteractableEvents>.Tick();
        FkUiStore<Button, ButtonEvents>.Tick();
        FkUiStore<Slider, SliderEvents>.Tick();
        FkUiStore<Toggle, ToggleEvents>.Tick();
        FkUiStore<Dropdown, DropdownEvents>.Tick();
        FkUiStore<InputField, InputFieldEvents>.Tick();
        FkUiStore<Scrollbar, ScrollbarEvents>.Tick();
        FkUiStore<CircularSlider, CircularSliderEvents>.Tick();
        FkUiStore<ScrollRect, ScrollRectEvents>.Tick();
    }
}
