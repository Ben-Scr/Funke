import Funke
namespace Funke.UI;

public class CircularSlider : Component {
public:
    protected override ulong FkType() { return 11ul; }
    float Value { get { return Reinterpret<float>((uint)FkCircularSlider_GetValue(ID, 0ul)); } set { FkCircularSlider_SetValue(ID, (ulong)Reinterpret<uint>(value)); } }
    float MinValue { get { return Reinterpret<float>((uint)FkCircularSlider_GetMinValue(ID, 0ul)); } set { FkCircularSlider_SetMinValue(ID, (ulong)Reinterpret<uint>(value)); } }
    float MaxValue { get { return Reinterpret<float>((uint)FkCircularSlider_GetMaxValue(ID, 0ul)); } set { FkCircularSlider_SetMaxValue(ID, (ulong)Reinterpret<uint>(value)); } }
    bool WholeNumbers { get { return (FkCircularSlider_GetWholeNumbers(ID, 0ul) != 0ul); } set { FkCircularSlider_SetWholeNumbers(ID, (value ? 1ul : 0ul)); } }
    bool IsReadOnly { get { return (FkCircularSlider_GetIsReadOnly(ID, 0ul) != 0ul); } set { FkCircularSlider_SetIsReadOnly(ID, (value ? 1ul : 0ul)); } }
    float StartAngleDegrees { get { return Reinterpret<float>((uint)FkCircularSlider_GetStartAngleDegrees(ID, 0ul)); } set { FkCircularSlider_SetStartAngleDegrees(ID, (ulong)Reinterpret<uint>(value)); } }
    float SweepDegrees { get { return Reinterpret<float>((uint)FkCircularSlider_GetSweepDegrees(ID, 0ul)); } set { FkCircularSlider_SetSweepDegrees(ID, (ulong)Reinterpret<uint>(value)); } }
    bool Clockwise { get { return (FkCircularSlider_GetClockwise(ID, 0ul) != 0ul); } set { FkCircularSlider_SetClockwise(ID, (value ? 1ul : 0ul)); } }
    float RingThickness { get { return Reinterpret<float>((uint)FkCircularSlider_GetRingThickness(ID, 0ul)); } set { FkCircularSlider_SetRingThickness(ID, (ulong)Reinterpret<uint>(value)); } }
    int RingSegments { get { return Reinterpret<int>((uint)(FkCircularSlider_GetRingSegments(ID, 0ul) & 4294967295ul)); } set { FkCircularSlider_SetRingSegments(ID, (ulong)Reinterpret<uint>(value)); } }
    UITransitionMode TransitionMode { get { return (UITransitionMode)FkCircularSlider_GetTransitionMode(ID, 0ul); } set { FkCircularSlider_SetTransitionMode(ID, (ulong)value); } }
    Vector4 BackgroundColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetBackgroundColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetBackgroundColor(ID, value.LowBits()); } }
    Vector4 FillColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetFillColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetFillColor(ID, value.LowBits()); } }
    Vector4 NormalColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetNormalColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetNormalColor(ID, value.LowBits()); } }
    Vector4 HoveredColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetHoveredColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetHoveredColor(ID, value.LowBits()); } }
    Vector4 PressedColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetPressedColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetPressedColor(ID, value.LowBits()); } }
    Vector4 DisabledColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetDisabledColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetDisabledColor(ID, value.LowBits()); } }
    Vector4 FocusedColor { get { return FunkeApiTypes.DecodeVector4(FkCircularSlider_GetFocusedColor(ID, 0ul), FkReadExtra(0ul, 0ul)); } set { FkWriteExtra(value.HighBits(), 0ul); FkCircularSlider_SetFocusedColor(ID, value.LowBits()); } }
    bool ValueChangedThisFrame => (FkCircularSlider_GetValueChangedThisFrame(ID, 0ul) != 0ul);
    Funke.Entity? HandleEntity { get { return Funke.Entity.FromId(FkCircularSlider_GetHandleEntity(ID, 0ul)); } set { ulong id = 0ul; if (value != null) id = value.Value.ID; FkCircularSlider_SetHandleEntity(ID, id); } }
    Funke.Texture? NormalSprite { get { return Funke.Texture.FromAssetUUID(FkCircularSlider_GetNormalSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkCircularSlider_SetNormalSprite(ID, guid); } }
    Funke.Texture? HoveredSprite { get { return Funke.Texture.FromAssetUUID(FkCircularSlider_GetHoveredSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkCircularSlider_SetHoveredSprite(ID, guid); } }
    Funke.Texture? PressedSprite { get { return Funke.Texture.FromAssetUUID(FkCircularSlider_GetPressedSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkCircularSlider_SetPressedSprite(ID, guid); } }
    Funke.Texture? DisabledSprite { get { return Funke.Texture.FromAssetUUID(FkCircularSlider_GetDisabledSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkCircularSlider_SetDisabledSprite(ID, guid); } }
    Funke.Texture? FocusedSprite { get { return Funke.Texture.FromAssetUUID(FkCircularSlider_GetFocusedSprite(ID, 0ul)); } set { ulong guid = 0ul; if (value != null) guid = value.Value.UUID; FkCircularSlider_SetFocusedSprite(ID, guid); } }
    float NormalizedValue {
        get {
            float min = MinValue;
            float range = MaxValue - min;
            return range != 0.0f ? (Value - min) / range : 0.0f;
        }
    }
    void SetValue(float value, bool notifyEvent = true) {
        float previous = Value;
        Value = value;
        FkCircularSlider_MarkValueObserved(ID, 0ul);
        float applied = Value;
        if (notifyEvent && applied != previous) Events.FkChanged(applied);
    }
    CircularSliderEvents& Events { get { return FkUiStore<CircularSlider, CircularSliderEvents>.For(ID).Get(); } }
    WidgetEvent<float> ValueChanged {
        get {
            Shared<CircularSliderEvents> state = FkUiStore<CircularSlider, CircularSliderEvents>.For(ID);
            WidgetEvent<float> signal;
            signal.FkAdd = (Action<float> h) => { state.Get().ValueChanged += h; };
            signal.FkRemove = (Action<float> h) => { state.Get().ValueChanged -= h; };
            return signal;
        }
        set {}
    }
}
