import System
import System.Threading
import System.Threading.Tasks
namespace Funke.Jobs;

public class AtomicInt {
    private: System.Threading.Atomic<int> bits;
    static int Encode(int v) { return v; }
    static int Decode(int v) { return v; }
    public: AtomicInt() {}
    AtomicInt(int initialValue) { Store(initialValue); }
    int Value {get { return Load(); } set { Store(value); } }
    int Load() {return Decode(bits.Load());}
    void Store(int v) {bits.Store(Encode(v));}
    int Exchange(int v) {return Decode(bits.Exchange(Encode(v)));}
    int CompareExchange(int v,int comparand) { int old=Encode(comparand); bits.CompareExchange(old,Encode(v));return Decode(old); }
    int Add(int operand) { int old=bits.Load(); while(true) { int current=Decode(old); int next=current + operand; if(bits.CompareExchange(old,Encode(next))) return next; }return Decode(old); }
    int FetchMin(int operand) { int old=bits.Load(); while(true) { int current=Decode(old); int next=operand < current ? operand : current; if(bits.CompareExchange(old,Encode(next))) return current; }return Decode(old); }
    int FetchMax(int operand) { int old=bits.Load(); while(true) { int current=Decode(old); int next=operand > current ? operand : current; if(bits.CompareExchange(old,Encode(next))) return current; }return Decode(old); }
    int Or(int operand) { int old=bits.Load(); while(true) { int current=Decode(old); int next=current | operand; if(bits.CompareExchange(old,Encode(next))) return current; }return Decode(old); }
    int And(int operand) { int old=bits.Load(); while(true) { int current=Decode(old); int next=current & operand; if(bits.CompareExchange(old,Encode(next))) return current; }return Decode(old); }
    int Sub(int operand) {return Add(-operand);}
    int Increment() {return Add(1);}
    int Decrement() {return Add(-1);}
    string ToString() { return (string)Load(); }
}
