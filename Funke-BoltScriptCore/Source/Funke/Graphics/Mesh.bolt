import System
import Math
import Type
import System.Text
namespace Funke;

public class Mesh {
private:
    ulong guid;
public:
    ulong UUID => guid;
    ulong FkKind() { return 11ul; }
    void FkSetGuid(ulong value) { guid = value; }
    string Path => FunkeText.Read(FkAsset_GetPathBuffer(UUID,0ul));
    string Name => FunkeText.Read(FkAsset_GetDisplayNameBuffer(UUID,0ul));
    static Mesh? FromAssetUUID(ulong guid) { if (guid == 0ul) return null; Mesh value; value.FkSetGuid(guid); return value; }
    static Mesh Create() { Mesh mesh; mesh.FkSetGuid(FkService.Mesh_CreateRuntime()); return mesh; }
    bool IsValid => UUID != 0ul && FkService.Mesh_GetInfo(UUID, null, 0) != 0;
    bool IsRuntime => UUID != 0ul && FkService.Mesh_IsRuntime(UUID) != 0;
    private float[] Read() { float[] v = new float[8]; FkService.Mesh_GetInfo(UUID, &v[0], 8); return v; }
    int VertexCount => (int)Read()[0];
    int TriangleCount => (int)Read()[1];
    Vector3 BoundsMin { get { float[] v = Read(); return Vector3(v[2], v[3], v[4]); } }
    Vector3 BoundsMax { get { float[] v = Read(); return Vector3(v[5], v[6], v[7]); } }
    void SetData(System.ReadOnlySpan<Vector3> positions, System.ReadOnlySpan<int> indices,
                 System.ReadOnlySpan<Vector3> normals = default, System.ReadOnlySpan<Vector2> uvs = default) {
        if ((!normals.IsEmpty && normals.Length != positions.Length) || (!uvs.IsEmpty && uvs.Length != positions.Length) || indices.Length % 3 != 0)
            throw System.InvalidOperationException("Invalid runtime mesh vertex attributes or triangle list.");
        Vector3[] p = positions.ToArray(), n = normals.ToArray();
        Vector2[] uv = uvs.ToArray();
        int[] ix = indices.ToArray();
        void* pp = null; void* np = null; void* up = null; void* ip = null;
        if (p.Length > 0) pp = &p[0];
        if (n.Length > 0) np = &n[0];
        if (uv.Length > 0) up = &uv[0];
        if (ix.Length > 0) ip = &ix[0];
        if (FkService.Mesh_SetData(UUID, pp, np, up, p.Length, ip, ix.Length) == 0) throw System.InvalidOperationException("Could not set runtime mesh data.");
    }
    void Clear() { SetData(System.ReadOnlySpan<Vector3>(), System.ReadOnlySpan<int>()); }
    void Destroy() { FkService.Mesh_DestroyRuntime(UUID); }
    bool Equals(Mesh? other) { return other.HasValue && UUID == other.Value.UUID; }
    int GetHashCode() { return Reinterpret<int>((uint)((UUID ^ (UUID >> 32)) & 4294967295ul)); }

    static bool operator ==(Mesh a, Mesh b) { return a.UUID == b.UUID; }
    static bool operator !=(Mesh a, Mesh b) { return a.UUID != b.UUID; }
    static bool operator ==(Mesh a, Mesh? b) { return b.HasValue && a.UUID == b.Value.UUID; }
    static bool operator !=(Mesh a, Mesh? b) { return !b.HasValue || a.UUID != b.Value.UUID; }
    static bool operator ==(Mesh? a, Mesh b) { return a.HasValue && a.Value.UUID == b.UUID; }
    static bool operator !=(Mesh? a, Mesh b) { return !a.HasValue || a.Value.UUID != b.UUID; }
}
