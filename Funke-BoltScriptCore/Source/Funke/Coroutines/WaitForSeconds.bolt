import System
import System.Threading
import System.Threading.Tasks
namespace Funke.Coroutines;

public struct WaitForSeconds {
    private float saved;
    private CancellationToken cancellation;
    public WaitForSeconds(float seconds, System.Threading.CancellationToken token=default) {saved=seconds;cancellation=token;}
    public Task<void> AsTask(){return CoroutineContext.Wait(0,saved,false,null,cancellation);}
    public CoroutineAwaiter GetAwaiter() { return CoroutineAwaiter(0,saved,false,null,cancellation); }
}
